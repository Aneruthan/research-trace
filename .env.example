# =================================================================
# ResearchTrace Docker Environment Configuration Template
# Copy this file to .env before starting: cp .env.example .env
# Never commit the actual .env file containing live secrets.
# =================================================================

# Database Configuration (for internal container PostgreSQL)
DB_NAME=researchtrace
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_HOST_PORT=5433

# Port Configuration on Host
FRONTEND_PORT=5173
BACKEND_PORT=8080

# Google Gemini API Key (Required for live AI extraction)
# Get a key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_CHAT=google-genai

# AI Extraction Mode
# Set to 'gemini' for live AI extraction (requires GEMINI_API_KEY above)
# Set to 'stub' for offline / deterministic demo extraction without API keys
TASK_EXTRACTOR_MODE=gemini
RESEARCH_EXTRACTOR_MODE=gemini

# Application Version Tag
APP_VERSION=d70f861
