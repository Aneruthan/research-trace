# =================================================================
# ResearchTrace Docker Environment Configuration Template
# Copy this file to .env before starting: cp .env.example .env
# Never commit the actual .env file containing live secrets.
# =================================================================

# Database Configuration (for internal container PostgreSQL)
DB_NAME=researchtrace
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_HOST_PORT=5433

# Port Configuration on Host
FRONTEND_PORT=5173
BACKEND_PORT=8080

# Google Gemini API Key (Optional for offline demo; required for live AI extraction)
# Get a key at: https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_CHAT=none

# AI Extraction Mode
# Set to 'stub' for offline / evaluation mode without external API keys (default)
# Set to 'gemini' for live AI extraction (requires valid GEMINI_API_KEY and GEMINI_CHAT=google-genai)
TASK_EXTRACTOR_MODE=stub
RESEARCH_EXTRACTOR_MODE=stub

# Application Version Tag
APP_VERSION=d70f861
